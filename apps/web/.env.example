# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://expensico.com

# ─── Owner details (shown on legal pages) ──────────────────────────────
# Name and contact email default to the values in src/config/site.ts; set these only to override.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_COUNTRY=India
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_CONTACT_EMAIL=
# Date your legal documents take effect (YYYY-MM-DD)
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
NEXT_PUBLIC_TWITTER_HANDLE=

# ─── Contact form (optional; form is hidden until both are set) ────────
RESEND_API_KEY=
# Where messages go. Defaults to the public contact email above.
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Expensico <contact@expensico.com>"
CONTACT_FROM_EMAIL=
# Cloudflare Turnstile spam protection (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Cookieless analytics (optional) ───────────────────────────────────
# "plausible" or "umami"
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: your domain (expensico.com). Umami: the website ID.
NEXT_PUBLIC_ANALYTICS_SITE_ID=
# Optional for Plausible (defaults to plausible.io); required for Umami.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# ─── File processing service (optional; enables Word/Excel/PPT → PDF) ──
# Base URL of services/processor, e.g. https://expensico-processor.onrender.com
NEXT_PUBLIC_PROCESSOR_URL=
# Same value as on the processor. Generate with: openssl rand -base64 48
PROCESSOR_SHARED_SECRET=

# ─── Advertising (leave empty until you're ready; see docs/DEPLOYMENT.md) ─
NEXT_PUBLIC_ADSENSE_CLIENT=
